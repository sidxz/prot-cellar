# Backend env — copy to backend/.env and fill in the secret(s). Do NOT commit backend/.env.
DATABASE_URL=postgresql+asyncpg://protcellar:protcellar@localhost:5433/protcellar
REDIS_URL=redis://localhost:6380
CORS_ORIGINS=http://localhost:3001
APP_ENV=development

# Duar auth — point at the same identity-service as chem-cellar.
# Point at your Duar deployment, or http://localhost:9003 if you run it locally.
DUAR_URL=https://duar.example.org
DUAR_SERVICE_NAME=prot-cellar
DUAR_SERVICE_KEY=          # sk_... service key from Duar (secret — keep out of git)
DUAR_IDP_AUDIENCE=         # OAuth client_id the IdP token's aud must equal (Google client id)
DUAR_IDP_ISSUER=https://accounts.google.com
