# Frontend env — copy to frontend/.env.local and fill in the secret(s). Do NOT commit .env.local.
# APP_ prefix = server-side only (read by /api/config + /api/auth/mint), never bundled into client JS.
APP_URL=http://localhost:3000
APP_API_BASE_URL=http://localhost:8001
APP_ENV=development

# Sentinel auth — same identity-service as chem-cellar.
APP_SENTINEL_URL=https://sentinel.orca-03.biobio.tamu.edu
APP_SENTINEL_SERVICE_NAME=prot-cellar
APP_SENTINEL_SERVICE_KEY=      # sk_... service key (server-side only; do not commit)

# IdP client ids (Google — same OAuth client as chem-cellar).
APP_SENTINEL_GOOGLE_CLIENT_ID=
APP_SENTINEL_ENTRA_CLIENT_ID=
APP_SENTINEL_ENTRA_TENANT_ID=
