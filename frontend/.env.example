# Frontend env — copy to frontend/.env.local and fill in the secret(s). Do NOT commit .env.local.
# APP_ prefix = server-side only (read by /api/config + /api/auth/mint), never bundled into client JS.
APP_URL=http://localhost:3001
APP_API_BASE_URL=http://localhost:8001
APP_ENV=development

# Duar auth — same identity-service as chem-cellar.
APP_DUAR_URL=https://duar.orca-03.biobio.tamu.edu
APP_DUAR_SERVICE_NAME=prot-cellar
APP_DUAR_SERVICE_KEY=      # sk_... service key (server-side only; do not commit)

# IdP client ids (Google — same OAuth client as chem-cellar).
APP_DUAR_GOOGLE_CLIENT_ID=
APP_DUAR_ENTRA_CLIENT_ID=
APP_DUAR_ENTRA_TENANT_ID=
