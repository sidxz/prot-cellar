# Backend env — copy to backend/.env and fill in the secret(s). Do NOT commit backend/.env.
DATABASE_URL=postgresql+asyncpg://protcellar:protcellar@localhost:5433/protcellar
CORS_ORIGINS=http://localhost:3000
APP_ENV=development

# Sentinel auth — point at the same identity-service as chem-cellar.
# Use the shared remote Sentinel (below) or http://localhost:9003 if you run it locally.
SENTINEL_URL=https://sentinel.orca-03.biobio.tamu.edu
SENTINEL_SERVICE_NAME=prot-cellar
SENTINEL_SERVICE_KEY=          # sk_... service key from Sentinel (secret — keep out of git)
SENTINEL_IDP_AUDIENCE=         # OAuth client_id the IdP token's aud must equal (Google client id)
SENTINEL_IDP_ISSUER=https://accounts.google.com
