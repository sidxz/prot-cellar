# Production deploy settings for docker-compose.prod.yml (make prod-up).
# Copy to .env (gitignored) next to the compose files and fill in.
# Local development uses backend/.env + frontend/.env.local instead.

# Image tag to run. "latest" = main HEAD; pin a release (e.g. 0.1.0-beta.1)
# for reproducible deploys.
PROT_CELLAR_TAG=latest

# Browser-reachable URLs. Use https://… behind a TLS-terminating reverse proxy.
# APP_URL is also the backend's allowed CORS origin.
APP_URL=http://localhost:3001
APP_API_BASE_URL=http://localhost:8001

# Duar auth (shared identity-service). One service key serves backend + frontend.
DUAR_URL=https://duar.example.org
DUAR_SERVICE_NAME=prot-cellar
DUAR_SERVICE_KEY=
# The IdP token's `aud` must equal this — your OAuth client id.
DUAR_IDP_AUDIENCE=
DUAR_IDP_ISSUER=https://accounts.google.com

# IdP client ids shown by the login page (Google: same value as DUAR_IDP_AUDIENCE).
APP_DUAR_GOOGLE_CLIENT_ID=
APP_DUAR_ENTRA_CLIENT_ID=
APP_DUAR_ENTRA_TENANT_ID=

LOG_LEVEL=INFO

# Postgres credentials. Compose falls back to protcellar/protcellar when unset —
# fine on a laptop, never on a server: set a strong password before first start.
# POSTGRES_USER=protcellar
# POSTGRES_PASSWORD=
# POSTGRES_DB=protcellar

# Only for upgrading a database created before the workspace-tenancy migration:
# the workspace that inherits rows still under the shared workspace.
# MIGRATION_TARGET_WORKSPACE_ID=
